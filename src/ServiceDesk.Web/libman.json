{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap@5.3.9",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [ "css/bootstrap.min.css", "js/bootstrap.bundle.min.js" ]
    },
    {
      "library": "bootstrap-icons@1.13.2",
      "destination": "wwwroot/lib/bootstrap-icons/",
      "files": [ "font/bootstrap-icons.min.css", "font/fonts/bootstrap-icons.woff2", "font/fonts/bootstrap-icons.woff" ]
    },
    {
      "library": "datatables.net@3.1.5",
      "destination": "wwwroot/lib/datatables/",
      "files": [ "dataTables.min.js" ]
    },
    {
      "library": "datatables.net-bs5@3.1.5",
      "destination": "wwwroot/lib/datatables/",
      "files": [ "dataTables.bootstrap5.min.js", "dataTables.bootstrap5.min.css" ]
    },
    {
      "library": "jquery@3.7.1",
      "destination": "wwwroot/lib/jquery/",
      "files": [ "jquery.min.js" ]
    },
    {
      "library": "jquery-validate@1.21.0",
      "destination": "wwwroot/lib/jquery-validate/",
      "files": [ "jquery.validate.min.js" ]
    },
    {
      "library": "jquery-validation-unobtrusive@4.0.0",
      "destination": "wwwroot/lib/jquery-validation-unobtrusive/",
      "files": [ "jquery.validate.unobtrusive.min.js" ]
    },
    {
      "provider": "jsdelivr",
      "library": "@fontsource/plus-jakarta-sans@5.3.0",
      "destination": "wwwroot/lib/fonts/plus-jakarta-sans/",
      "files": [
        "files/plus-jakarta-sans-latin-400-normal.woff2",
        "files/plus-jakarta-sans-latin-500-normal.woff2",
        "files/plus-jakarta-sans-latin-600-normal.woff2",
        "files/plus-jakarta-sans-latin-700-normal.woff2",
        "files/plus-jakarta-sans-latin-800-normal.woff2",
        "LICENSE"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "@fontsource/ibm-plex-mono@5.3.0",
      "destination": "wwwroot/lib/fonts/ibm-plex-mono/",
      "files": [
        "files/ibm-plex-mono-latin-400-normal.woff2",
        "files/ibm-plex-mono-latin-500-normal.woff2",
        "files/ibm-plex-mono-latin-600-normal.woff2",
        "LICENSE"
      ]
    }
  ]
}
