{
  "App": {
    "Name": "ServiceDesk",
    "OrganizationName": "Management Information System",
    "TimeZone": "Asia/Manila"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "LogFiles": {
    "Enabled": true,
    "Directory": "logs",
    "RetainedDays": 30
  },
  "AllowedHosts": "*"
}
