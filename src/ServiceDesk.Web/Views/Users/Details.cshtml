@model ServiceDesk.Web.ViewModels.Users.UserDetailsViewModel
@{
    ViewData["Title"] = Model.FullName;
}

<div class="sd-page-head">
    <div>
        <h2>@Model.FullName</h2>
        <p class="sd-page-lede mb-0">Manage user roles and account status.</p>
    </div>
    <div class="sd-page-actions">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i>Back to users</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title mb-0">Account</h3></div>
            <div class="card-body">
                <dl class="sd-kv">
                    <dt>Username</dt><dd>@Model.UserName</dd>
                    <dt>Employee #</dt><dd>@(Model.EmployeeNumber ?? "—")</dd>
                    <dt>Email</dt><dd>@(Model.Email ?? "—")</dd>
                    <dt>Department</dt><dd>@(Model.Department ?? "—")</dd>
                    <dt>Status</dt><dd>@(Model.IsActive ? "Active" : "Inactive")</dd>
                    <dt>Password</dt><dd>@(Model.MustChangePassword ? "Must change on next sign-in" : "OK")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header"><h3 class="card-title mb-0">Roles</h3></div>
            <div class="card-body">
                <form method="post" asp-action="UpdateRoles" asp-route-id="@Model.Id" class="d-grid gap-3">
                    @Html.AntiForgeryToken()
                    <p class="text-body-secondary mb-0">Select one or more roles. Permissions are applied via role claims (user may need to sign in again after changes).</p>
                    <div class="d-grid gap-2">
                        @foreach (var role in Model.AllRoles)
                        {
                            var checkedRole = Model.SelectedRoles.Contains(role, StringComparer.OrdinalIgnoreCase);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="roles" value="@role" id="role_@role" @(checkedRole ? "checked" : "") />
                                <label class="form-check-label" for="role_@role">@role</label>
                            </div>
                        }
                    </div>
                    <div>
                        <button type="submit" class="btn btn-primary">Save roles</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
