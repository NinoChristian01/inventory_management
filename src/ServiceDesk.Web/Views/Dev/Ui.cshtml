@model UiKitViewModel
@{
    ViewData["Title"] = "UI kit";
    ViewData["Parent"] = "Developer";
}
@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
}

<div class="sd-page-head">
    <p class="sd-page-lede">Every shared component with sample data, for checking the look on desktop and phone. This page exists only in Development, and nothing on it touches real data.</p>
    <div class="sd-page-actions">
        <a class="btn btn-outline-secondary" asp-action="SignIn"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>Sign-in preview</a>
        <button type="button" class="btn btn-primary" data-sd-health-check><i class="bi bi-heart-pulse" aria-hidden="true"></i>Run health check</button>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xxl-6">
        <section class="card h-100" aria-labelledby="kitButtons">
            <div class="card-header"><h2 class="card-title" id="kitButtons">Buttons</h2></div>
            <div class="card-body d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i>New ticket</button>
                <button type="button" class="btn btn-outline-primary">Assign to me</button>
                <button type="button" class="btn btn-outline-secondary">Cancel</button>
                <button type="button" class="btn btn-light">Secondary</button>
                <button type="button" class="btn btn-danger"><i class="bi bi-trash3" aria-hidden="true"></i>Delete</button>
                <button type="button" class="btn btn-primary btn-sm">Small</button>
                <button type="button" class="btn btn-primary" disabled>Disabled</button>
                <button type="button" class="btn sd-icon-btn border" aria-label="More actions"><i class="bi bi-three-dots" aria-hidden="true"></i></button>
            </div>
        </section>
    </div>

    <div class="col-12 col-xxl-6">
        <section class="card h-100" aria-labelledby="kitStatus">
            <div class="card-header"><h2 class="card-title" id="kitStatus">Ticket status</h2></div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var status in Enum.GetValues<TicketStatusCode>())
                    {
                        <status-badge code="@status" />
                    }
                </div>
                <p class="small text-body-secondary mt-3 mb-0">Amber marks statuses that pause the SLA clock. Closed and Canceled are final.</p>
            </div>
        </section>
    </div>

    <div class="col-12 col-xxl-6">
        <section class="card h-100" aria-labelledby="kitPriority">
            <div class="card-header"><h2 class="card-title" id="kitPriority">Priority, SLA and identifiers</h2></div>
            <div class="card-body d-grid gap-3">
                <div class="d-flex flex-wrap gap-4">
                    @foreach (var priority in Enum.GetValues<PriorityCode>())
                    {
                        <priority-indicator code="@priority" />
                    }
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <sla-chip state="OnTrack" text="Due in 3h 20m" />
                    <sla-chip state="AtRisk" text="Due in 25 min" />
                    <sla-chip state="Breached" text="Overdue by 1h 05m" />
                    <sla-chip state="Paused" text="Paused" />
                    <sla-chip state="Met" text="Met" />
                </div>
                <div class="d-flex flex-wrap align-items-center gap-4">
                    <span class="sd-ticket-no">MIS-26K013</span>
                    <span class="sd-user-chip">
                        <span class="sd-avatar" aria-hidden="true">@DisplayHelpers.Initials("Juan Dela Cruz")</span>
                        <span>
                            <span class="d-block fw-semibold lh-sm">Juan Dela Cruz</span>
                            <span class="d-block small text-body-secondary lh-sm">Agent · MIS</span>
                        </span>
                    </span>
                    <span class="small">Filed <local-time value="@Model.NowUtc.AddHours(-3)" /></span>
                </div>
            </div>
        </section>
    </div>

    <div class="col-12 col-xxl-6">
        <section class="card h-100" aria-labelledby="kitFeedback">
            <div class="card-header"><h2 class="card-title" id="kitFeedback">Feedback</h2></div>
            <div class="card-body d-grid gap-3">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var kind in new[] { "success", "info", "warning", "error" })
                    {
                        <form method="post" asp-action="Toast" class="d-inline">
                            <input type="hidden" name="kind" value="@kind" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Show @kind toast</button>
                        </form>
                    }
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-sd-client-toast>Toast from the browser</button>
                </div>
                <form method="post" asp-action="Confirm">
                    <button type="submit" class="btn btn-danger"
                            data-confirm-kind="danger"
                            data-confirm-title="Delete the category “Printers”?"
                            data-confirm-text="It moves to the Recycle Bin. Tickets that use it keep their history, and an admin can restore it."
                            data-confirm-ok="Move to Recycle Bin"
                            data-confirm-cancel="Keep it">
                        <i class="bi bi-trash3" aria-hidden="true"></i>Delete category
                    </button>
                </form>
                <div class="alert alert-warning d-flex gap-2 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <div>Inline alerts explain a problem on the page itself, such as a ticket that changed while you were editing it.</div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-12">
        <section class="card" aria-labelledby="kitTable">
            <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
                <h2 class="card-title" id="kitTable">Ticket table</h2>
                <span class="small text-body-secondary">Sample rows, not real tickets</span>
            </div>
            <div class="card-body table-responsive">
                @* .sd-stack: rows become labeled cards on phones. .table-responsive: sideways scroll without JavaScript. *@
                <table class="table table-hover align-middle w-100 sd-stack" data-sd-datatable data-sd-page-length="5">
                    <thead>
                        <tr>
                            <th scope="col">Ticket</th>
                            <th scope="col">Subject</th>
                            <th scope="col">Requester</th>
                            <th scope="col">Status</th>
                            <th scope="col">Priority</th>
                            <th scope="col">SLA</th>
                            <th scope="col">Filed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.SampleTickets)
                        {
                            <tr>
                                <td><span class="sd-ticket-no">@ticket.Number</span></td>
                                <td class="sd-cell-subject m-title">@ticket.Subject</td>
                                <td>
                                    <span class="d-block">@ticket.Requester</span>
                                    <span class="d-block small text-body-secondary">@ticket.Department</span>
                                </td>
                                <td><status-badge code="@ticket.Status" /></td>
                                <td><priority-indicator code="@ticket.Priority" /></td>
                                <td><sla-chip state="@ticket.Sla" text="@ticket.SlaText" /></td>
                                <td data-order="@ticket.CreatedUtc.ToString("o", System.Globalization.CultureInfo.InvariantCulture)"><local-time value="@ticket.CreatedUtc" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-7">
        <section class="card h-100" aria-labelledby="kitForm">
            <div class="card-header"><h2 class="card-title" id="kitForm">Form fields</h2></div>
            <form method="post" asp-action="SubmitForm" novalidate>
                <div class="card-body d-grid gap-3">
                    <div asp-validation-summary="ModelOnly" class="sd-validation-summary" role="alert"></div>
                    <div>
                        <label asp-for="Form.Subject" class="form-label"></label>
                        <input asp-for="Form.Subject" class="form-control" placeholder="For example: Printer in Room 101 won't print" />
                        <span asp-validation-for="Form.Subject"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-12 col-md-7">
                            <label asp-for="Form.Category" class="form-label"></label>
                            <select asp-for="Form.Category" asp-items="Model.Form.Categories" class="form-select"></select>
                            <span asp-validation-for="Form.Category"></span>
                        </div>
                        <div class="col-12 col-md-5">
                            <label asp-for="Form.Priority" class="form-label"></label>
                            <select asp-for="Form.Priority" asp-items="Model.Form.Priorities" class="form-select"></select>
                            <div class="form-text">Only agents can set Critical.</div>
                        </div>
                    </div>
                    <div>
                        <label asp-for="Form.Description" class="form-label"></label>
                        <textarea asp-for="Form.Description" class="form-control" rows="4" placeholder="What happened, where, and since when?"></textarea>
                        <span asp-validation-for="Form.Description"></span>
                    </div>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-end gap-2">
                    <button type="reset" class="btn btn-light">Clear</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send" aria-hidden="true"></i>Submit sample</button>
                </div>
            </form>
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <section class="card h-100" aria-labelledby="kitEmpty">
            <div class="card-header"><h2 class="card-title" id="kitEmpty">Empty state</h2></div>
            <div class="card-body">
                <div class="sd-empty">
                    <span class="sd-empty-icon" aria-hidden="true"><i class="bi bi-inbox"></i></span>
                    <p class="sd-empty-title">No tickets waiting on you</p>
                    <p>When a ticket is assigned to you or your team, it shows up here.</p>
                    <button type="button" class="btn btn-outline-primary btn-sm mt-2">View team queue</button>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/datatables/dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/dev-ui.js" asp-append-version="true"></script>
}
