@model SignInPreviewViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}
<div class="sd-auth-intro">
    <h1>Sign in</h1>
    <p>Use the username and password the MIS office gave you.</p>
    <p class="sd-auth-preview"><i class="bi bi-eye" aria-hidden="true"></i>Layout preview for developers. Not connected to accounts.</p>
</div>

<form method="post" asp-action="SignIn" class="d-grid gap-3" novalidate>
    <div asp-validation-summary="ModelOnly" class="sd-validation-summary" role="alert"></div>
    <div>
        <label asp-for="UserName" class="form-label"></label>
        <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="UserName"></span>
    </div>
    <div>
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password"></span>
    </div>
    <div class="form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
    <p class="small text-body-secondary mb-0">Forgot your password? Ask the MIS office to reset it.</p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
