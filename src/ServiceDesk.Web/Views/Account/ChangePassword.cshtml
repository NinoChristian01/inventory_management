@model ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Change password";
}
<div class="sd-auth-intro">
    <h1>Change password</h1>
    @if (Model.IsForced)
    {
        <p>You must set a new password before continuing.</p>
    }
    else
    {
        <p>Choose a strong password you can remember.</p>
    }
</div>

<form method="post" asp-action="ChangePassword" class="d-grid gap-3" novalidate>
    <div asp-validation-summary="ModelOnly" class="sd-validation-summary" role="alert"></div>
    <div>
        <label asp-for="CurrentPassword" class="form-label"></label>
        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword"></span>
    </div>
    <div>
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
        <div class="form-text">At least 10 characters with upper, lower, and a digit.</div>
        <span asp-validation-for="NewPassword"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-lg w-100">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
