@model SystemStatusViewModel
@{
    ViewData["Title"] = "Dashboard";
    var healthCss = Model.OverallStatus switch
    {
        "Healthy" => "sd-health-ok",
        "Degraded" => "sd-health-warn",
        _ => "sd-health-bad",
    };
}
<div class="sd-page-head">
    <p class="sd-page-lede">Service desk for the @Model.OrganizationName office. This panel shows whether the system is healthy and which time zone it works in.</p>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <section class="card h-100" aria-labelledby="sdStatusTitle">
            <div class="card-header d-flex align-items-center justify-content-between gap-3">
                <h2 class="card-title" id="sdStatusTitle">System status</h2>
                <span class="sd-health @healthCss"><i class="bi bi-heart-pulse" aria-hidden="true"></i>@Model.OverallStatus</span>
            </div>
            <div class="card-body">
                <dl class="sd-kv">
                    <dt>Environment</dt>
                    <dd>@Model.EnvironmentName</dd>
                    <dt>Version</dt>
                    <dd class="sd-mono">@Model.Version</dd>
                    <dt>Time zone</dt>
                    <dd>@Model.TimeZoneId <span class="text-body-secondary">(@Model.UtcOffset)</span></dd>
                    <dt>Local time</dt>
                    <dd><local-time value="@Model.NowUtc" /></dd>
                    <dt>Server time (UTC)</dt>
                    <dd class="sd-mono">@Model.NowUtc.ToString("yyyy-MM-dd HH:mm 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</dd>
                    @if (Model.Runtime is not null)
                    {
                        <dt>Runtime</dt>
                        <dd>@Model.Runtime</dd>
                    }
                </dl>
            </div>
        </section>
    </div>

    <div class="col-12 col-xl-5">
        <section class="card h-100" aria-labelledby="sdChecksTitle">
            <div class="card-header">
                <h2 class="card-title" id="sdChecksTitle">Health checks</h2>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var check in Model.Checks)
                {
                    var ok = check.Status == "Healthy";
                    <li class="list-group-item d-flex align-items-start gap-3 py-3">
                        <i class="bi @(ok ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5" aria-hidden="true"></i>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@check.Name</div>
                            @if (!string.IsNullOrEmpty(check.Description))
                            {
                                <div class="small text-body-secondary">@check.Description</div>
                            }
                        </div>
                        <span class="small fw-semibold">@check.Status</span>
                    </li>
                }
            </ul>
            <div class="card-footer small text-body-secondary">
                Monitoring tools can read the same result as JSON at <a href="/health"><code>/health</code></a>.
            </div>
        </section>
    </div>
</div>
