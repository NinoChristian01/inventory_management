@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<section class="sd-error" aria-labelledby="sdErrorTitle">
    <p class="sd-error-code">@Model.StatusCode</p>
    <h2 class="sd-error-title" id="sdErrorTitle">@Model.Title</h2>
    <p class="sd-error-text">@Model.Message</p>
    <div class="sd-error-actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house" aria-hidden="true"></i>Go to the dashboard</a>
        <button type="button" class="btn btn-outline-secondary" data-sd-back hidden><i class="bi bi-arrow-left" aria-hidden="true"></i>Go back</button>
    </div>
    @if (Model.StatusCode >= 500 && !string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="sd-error-ref">Reference code: <code>@Model.RequestId</code></p>
    }
</section>
